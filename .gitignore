node_modules/
.DS_Store

# Environment files hold secrets; only the template is tracked
.env*
!.env.example

# Vercel CLI project link
.vercel/

# Next.js build output
.next/
next-env.d.ts
tsconfig.tsbuildinfo

# Firmware credentials (copy secrets.h.example -> secrets.h and fill in)
firmware/docket-agent/secrets.h

# Generated output from print runs
*.bin
out_*.png
# ...but the Basic Pitch model weights MUST ship (the tape decode 404s
# in production without them — tfjs reads the HTML error page as floats)
!public/basic-pitch/*.bin

# Local runtime state: PGlite (data/pg), json-driver files, Tape takes
data/

# Private local images in the repo-root jobs/ folder (the code never
# reads or writes it). Anchored, so app/jobs/ and app/api/jobs/ stay tracked.
/jobs/

# Scratch output (screenshots, probes)
tmp/

# Per-phase teaching notes for the multi-user build (private, not shipped)
learning/

# Claude Code working files (local settings, plans, worktrees)
.claude/

# Python bytecode
__pycache__/
*.pyc

# Impeccable design runs: generated images, prompts and review
# screenshots stay out of the public repo
.impeccable/mocks/
.impeccable/prompts/
.impeccable/review/
.impeccable/questions/
