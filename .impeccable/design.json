      "html": "<label class=\"ds-field\"><span class=\"ds-engr\">Name</span><span class=\"ds-fwin\"><input class=\"ds-in\" value=\"Kitchen printer\"></span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:10px}.ds-engr{font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;text-transform:uppercase;font-size:11.5px;letter-spacing:.15em;color:var(--pk-fill,#191918);text-shadow:var(--pk-engr-shadow)}.ds-fwin{border-radius:4px;padding:2px;background:linear-gradient(rgba(0,0,0,.28),rgba(255,255,255,.4))}.ds-in{width:100%;height:40px;box-sizing:border-box;padding:0 14px;border:0;border-radius:2px;outline:none;background:var(--pk-eink,#dcdad3);color:var(--pk-eink-ink,#23221f);font-family:\"Martian Mono\",monospace;font-stretch:82%;font-weight:500;font-size:16px;caret-color:var(--pk-eink-red,#a8291f)}.ds-fwin:focus-within{outline:2px solid var(--pk-focus,#161616);outline-offset:3px}.ds-in[aria-invalid=\"true\"]{box-shadow:inset 0 -2px 0 var(--pk-eink-red,#a8291f)}"
    },
    {
      "name": "Lamp",
      "kind": "custom",
      "refersTo": "led",
      "description": "A 3 mm LED in a black collar with its engraved state. Lime is online only; red is printing.",
      "html": "<span class=\"ds-lamp\"><span class=\"ds-led ds-led--on\"></span><span class=\"ds-engr\">Online</span></span>",
      "css": ".ds-lamp{display:inline-flex;align-items:center;gap:10px}.ds-led{width:13px;height:13px;border-radius:50%;background:#111;display:inline-grid;place-items:center}.ds-led::after{content:\"\";width:6.2px;height:6.2px;border-radius:50%;background:radial-gradient(circle at 46% 40%,#6f8a40,#3f5523)}.ds-led--on::after{background:radial-gradient(circle,#c4f544,#9be41f 55%,#5a9c0a);box-shadow:0 0 1.5px .4px rgba(170,236,50,.5)}.ds-engr{font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;text-transform:uppercase;font-size:11.5px;letter-spacing:.15em;color:var(--pk-fill,#191918);text-shadow:var(--pk-engr-shadow)}"
    },
    {
      "name": "Body With Head Plate",
      "kind": "card",
      "refersTo": "body",
      "description": "One machine body per page: the head plate holds the engraved page name and the lamp; plates join at seams.",
      "html": "<section class=\"ds-body\"><header class=\"ds-head\"><h1 class=\"ds-name\">Printer</h1><span class=\"ds-engr\">Online</span></header><div class=\"ds-plate ds-seam\"><span class=\"ds-num\">01</span> <span class=\"ds-engr\">Printers</span><p class=\"ds-note\">The code the printer prints, or a share code from another account.</p></div></section>",
      "css": ".ds-body{border-radius:12px;background:var(--pk-face,#dadad6);color:var(--pk-fill,#191918);box-shadow:0 0 0 1px rgba(0,0,0,.18),0 2px 0 rgba(0,0,0,.25),0 6px 10px -4px rgba(0,0,0,.2);overflow:hidden}.ds-head{display:flex;align-items:center;justify-content:space-between;min-height:58px;padding:0 30px}.ds-name{margin:0;font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;font-size:19px;letter-spacing:.32em;text-transform:uppercase;text-shadow:var(--pk-engr-shadow)}.ds-plate{padding:22px 30px}.ds-seam{border-top:2px solid rgba(0,0,0,.28);box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}.ds-num{font-family:\"Martian Mono\",monospace;font-stretch:82%;font-weight:600;font-size:11px;letter-spacing:.08em;color:var(--pk-fill-soft,#3b3a37)}.ds-engr{font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;text-transform:uppercase;font-size:11.5px;letter-spacing:.15em;text-shadow:var(--pk-engr-shadow)}.ds-note{margin:12px 0 0;font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:500;font-size:14px;line-height:1.45;color:var(--pk-fill-soft,#3b3a37)}"
    },
    {
      "name": "Nav Lever Key",
      "kind": "nav",
      "refersTo": "nav-lever-key",
      "description": "A long cream lever key in the nav well with its flag window in the plate; the current page holds it down and shows the red flag.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-lever\" href=\"#\"><span class=\"ds-flag\"></span><span class=\"ds-cap\">Home</span></a><a class=\"ds-lever\" href=\"#\" aria-current=\"page\"><span class=\"ds-flag\"></span><span class=\"ds-cap\">Printer</span></a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;padding:4px 0 4px 18px;background:var(--pk-face,#dadad6)}.ds-lever{display:flex;align-items:center;gap:10px;height:45px;text-decoration:none}.ds-flag{width:6px;height:22px;border-radius:1px;background:#151413}.ds-cap{width:166px;height:40px;display:flex;align-items:center;padding-left:20px;box-sizing:border-box;background:linear-gradient(#f2efe6,#dedad0);box-shadow:inset 0 -3px 0 rgba(0,0,0,.14),0 1px 0 #0b0b0a;font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;text-transform:uppercase;font-size:12px;letter-spacing:.15em;color:var(--pk-nav-legend,#2c2a26);transform-origin:0 50%;transition:transform .09s ease-out}.ds-lever:hover .ds-cap{transform:perspective(400px) rotateY(3deg)}.ds-lever[aria-current=\"page\"] .ds-cap{transform:perspective(400px) rotateY(9deg)}.ds-lever[aria-current=\"page\"] .ds-flag{background:#d8483a}.ds-lever:focus-visible{outline:2px solid var(--pk-focus,#161616);outline-offset:2px}"
    }
