  "components": [
    {
      "name": "Key Well",
      "kind": "button",
      "refersTo": "key",
      "description": "Tape-deck keys in one well under a black legend strip; the red print key is last.",
      "html": "<span class=\"ds-well\"><button class=\"ds-key\"><span class=\"ds-lg\">Load</span></button><button class=\"ds-key\" aria-pressed=\"true\"><span class=\"ds-lg\">Camera</span></button><button class=\"ds-key ds-key--print\"><span class=\"ds-lg\">Print</span></button></span>",
      "css": ".ds-well{position:relative;display:inline-flex;gap:2px;padding:22px 5px 3px}.ds-well::before{content:\"\";position:absolute;left:1.5px;right:1.5px;top:0;height:20px;border-radius:1.5px;background:var(--pk-strip,#161615);box-shadow:var(--pk-strip-edge)}.ds-well::after{content:\"\";position:absolute;z-index:-1;left:3px;right:3px;top:24.84px;bottom:3px;border:0 solid transparent;border-image:var(--pk-well) 42 fill / 14px / 8px stretch;background:#0b0b0a}.ds-key{position:relative;width:88px;height:45.84px;padding:0;border:0;background:#e9e7e1;border-radius:2px;cursor:pointer;transition:transform .06s ease-out;box-shadow:inset 0 -3px 0 rgba(0,0,0,.12)}.ds-key--print{width:104px;background:#b5422f}.ds-key:hover{transform:translateY(.5px)}.ds-key:active,.ds-key[aria-pressed=\"true\"]{transform:translateY(2px);box-shadow:inset 0 2px 3px rgba(0,0,0,.2)}.ds-key:focus-visible{outline:2px solid var(--pk-focus,#161616);outline-offset:2px}.ds-lg{position:absolute;left:0;right:0;top:-22px;height:20px;display:flex;align-items:center;justify-content:center;font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;text-transform:uppercase;font-size:10.5px;letter-spacing:.14em;color:var(--pk-strip-ink,#ebe8e1)}"
    },
    {
      "name": "Counter With Thumbwheel",
      "kind": "custom",
      "refersTo": "counter-window",
      "description": "Digit drums behind a window; the knurled wheel beside it steps the value (top half up, bottom half down). Never drags.",
      "html": "<span class=\"ds-counter\"><span class=\"ds-win\"><span class=\"ds-drum\">0</span><span class=\"ds-drum\">9</span></span><span class=\"ds-wheel\"><button aria-label=\"Up\"></button><button aria-label=\"Down\"></button></span></span>",
      "css": ".ds-counter{display:inline-flex;align-items:center;gap:7px}.ds-win{display:flex;gap:1.5px;height:36px;padding:3px;box-sizing:border-box;border-radius:2.5px;background:#090908}.ds-drum{position:relative;min-width:20px;padding:0 5px;display:flex;align-items:center;justify-content:center;border-radius:1px;background:var(--pk-drum,#1c1b19);color:var(--pk-drum-ink,#e9e5dc);font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;font-size:17px;font-variant-numeric:tabular-nums}.ds-drum::after{content:\"\";position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,.92),rgba(0,0,0,.1) 33%,rgba(255,250,240,.06) 42%,rgba(0,0,0,.14) 66%,rgba(0,0,0,.95))}.ds-wheel{position:relative;width:27px;height:46px;border-radius:3px;background:repeating-linear-gradient(#2a2a28 0 2px,#0d0d0c 2px 4px)}.ds-wheel>button{position:absolute;left:0;right:0;height:50%;border:0;background:none;cursor:pointer}.ds-wheel>button:last-child{bottom:0}.ds-wheel>button:hover{background:rgba(255,255,255,.04)}.ds-wheel>button:focus-visible{outline:2px solid var(--pk-focus,#161616)}"
    },
    {
      "name": "Slide Switch On/Off",
      "kind": "custom",
      "refersTo": "slide-switch",
      "description": "A ribbed cap in a slot, OFF and ON engraved either side; the orange ON mark shows only at ON.",
      "html": "<span class=\"ds-swrow\"><span class=\"ds-engr\">Off</span><button class=\"ds-sw\" role=\"switch\" aria-checked=\"true\"><span class=\"ds-cap\"></span></button><span class=\"ds-engr\">On</span></span>",
      "css": ".ds-swrow{display:inline-flex;align-items:center;gap:10px}.ds-engr{font-family:\"Hanken Grotesk\",Arial,sans-serif;font-weight:600;text-transform:uppercase;font-size:11.5px;letter-spacing:.15em;color:var(--pk-fill,#191918);text-shadow:var(--pk-engr-shadow)}.ds-sw{position:relative;width:52px;height:22px;padding:0;border:0;border-radius:4px;background:#161615;cursor:pointer}.ds-sw[aria-checked=\"true\"]::before{content:\"\";position:absolute;left:6px;top:6px;width:14px;height:10px;background:var(--switch-on,#cf6d2f)}.ds-cap{position:absolute;top:0;left:1px;width:27px;height:22px;border-radius:2px;background:repeating-linear-gradient(90deg,#3a3936 0 2px,#1d1c1a 2px 4px);transition:left .12s ease-out}.ds-sw[aria-checked=\"true\"] .ds-cap{left:24px}.ds-sw:hover .ds-cap{left:2px}.ds-sw[aria-checked=\"true\"]:hover .ds-cap{left:23px}.ds-sw:focus-visible{outline:2px solid var(--pk-focus,#161616);outline-offset:3px}"
    },
    {
