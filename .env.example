# Printer network settings, for the laptop printer agent only
# (agent/printer-agent.js sends over TCP through transport/print-net.js)
PRINTER_IP=
PRINTER_PORT=9100

# Print width in pixels (576 for 80mm, 384 for 58mm)
PRINT_WIDTH=576

# Directory containing the DejaVu TTF font files. Unset = the vendored
# render/fonts.
FONT_DIR=

# Job records kept per owner before the oldest finished ones are trimmed
JOB_CAP=50

# Storage driver for the hot path: json (local files in data/, the queue
# in PGlite) or redis (Upstash + Vercel Blob)
STORE_DRIVER=json

# Local state directory (json-driver files, Tape takes, PGlite). Unset =
# data/. PGLITE_DIR overrides only the PGlite folder (unset = DATA_DIR/pg).
DATA_DIR=
PGLITE_DIR=

# Which owner the local-dev DEVICE_TOKEN resolves to
OWNER_ID=default

# Local dev only: shared secret the laptop agents send to /next, /ack,
# /nack (real printers use pairing tokens). Defaults to dev-token; it
# resolves to the OWNER_ID owner.
DEVICE_TOKEN=

# User accounts (Better Auth). Postgres connection: the Neon URL in
# production, a Neon dev-branch URL locally — or leave unset and local dev
# uses PGlite, an embedded Postgres in data/pg (no cloud account needed).
# BETTER_AUTH_SECRET signs account session cookies (it falls back to the
# older SESSION_SECRET name); BETTER_AUTH_URL pins the canonical origin
# in production (e.g. https://docket.example.com), unset locally.
# scripts/print-calibration.js signs in with DOCKET_EMAIL/DOCKET_PASSWORD.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DOCKET_EMAIL=
DOCKET_PASSWORD=

# Seconds an unacked inflight job holds its lease before returning to the
# queue (redis driver only)
LEASE_SECONDS=120

# Laptop agents (agent/heartbeat.js, agent/printer-agent.js) and
# scripts/print-calibration.js: the server URL. Unset, the agents use
# http://localhost:$PORT (PORT defaults to 3000) and the calibration script
# uses http://localhost:3000 (its first argument overrides both).
PRINT_SERVER=
# Seconds between /tick POSTs from agent/heartbeat.js (each tick runs the
# registered plugins that are enabled and due)
HEARTBEAT_SECONDS=30
# Milliseconds between /next polls from agent/printer-agent.js
POLL_INTERVAL=3000

# Upstash Redis connection (required when STORE_DRIVER=redis).
# From the Upstash console, or auto-set by the Vercel Marketplace integration
# (which may name them KV_REST_API_URL / KV_REST_API_TOKEN — both pairs work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob read-write token (required when STORE_DRIVER=redis).
# Auto-set on Vercel deployments; copy from the Vercel dashboard for local use.
BLOB_READ_WRITE_TOKEN=

# Message ingestion (/ingest) — SMS forwarded from a phone, classified by
# Gemini, printed as task receipts. The forwarder authenticates with the
# per-owner token shown on the message-ingest Slips page.
# GEMINI_API_KEY from Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# World Cup plugin: comma-separated team abbreviations that seed its
# watchTeams config on first registration. Empty = all teams.
WATCH_TEAMS=

# Not for .env:
# - Vercel system variables the code reads: VERCEL (set on every Vercel
#   deployment; it turns off the dev-token default) and
#   VERCEL_GIT_COMMIT_SHA (the deployed commit; its short hash joins the
#   slip preview cache key). NODE_ENV is set by Next.js.
# - Tape eval hooks for npm run tape:eval only: TAPE_GAIN, TAPE_DETUNE,
#   TAPE_RETUNE, TAPE_TARGET, TAPE_DEREVERB, TAPE_RT60, TAPE_DRSTRENGTH
#   (the "A/B hooks" comment in scripts/tape-eval/score.mjs explains each).
# - UPDATE_GOLDEN=1 rewrites tests/golden/escpos.json (maintainer sign-off).

